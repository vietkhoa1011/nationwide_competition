// Schema Prisma cho "Luyện Thi 2027".
// Phiên bản đầu chỉ hỗ trợ câu hỏi chọn một đáp án đúng (SINGLE_CHOICE),
// nhưng đã dự trù QuestionType cho TRUE_FALSE / SHORT_ANSWER.
// Chạy: npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestionLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Phạm vi đề thi: đề công khai do quản trị viên quản lý, hoặc đề thuộc một lớp học.
enum ExamScope {
  PUBLIC
  CLASS
}

/// Vai trò trong một lớp học: giáo viên phụ trách và học sinh của lớp.
enum ClassroomMemberRole {
  TEACHER
  STUDENT
}

/// Loại tệp media của nội dung đề. Bản đầu chỉ nhận ảnh raster (PNG/JPEG/WEBP/GIF).
enum MediaAssetKind {
  IMAGE
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  accentColor String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics              Topic[]
  questions           Question[]
  exams               Exam[]
  classrooms          Classroom[]
  teacherApplications TeacherApplication[]

  @@index([position])
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  subjectId String
  createdAt DateTime @default(now())

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([subjectId, name])
  @@index([subjectId])
}

model Question {
  id             String        @id @default(cuid())
  subjectId      String
  topicId        String?
  type           QuestionType  @default(SINGLE_CHOICE)
  level          QuestionLevel @default(MEDIUM)
  /// Bản chữ thuần của nội dung (giữ để tương thích snapshot/luồng làm bài cũ).
  content        String
  explanation    String?
  /// Nội dung có cấu trúc RichDoc — nguồn sự thật của trình soạn thảo.
  contentDoc     Json?
  explanationDoc Json?
  /// Khai báo quy tắc chấm điểm riêng của từng loại câu (rỗng với SINGLE_CHOICE).
  rule           Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic          Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  options        QuestionOption[]
  examQuestions  ExamQuestion[]
  attemptAnswers AttemptAnswer[]

  @@index([subjectId])
  @@index([topicId])
  @@index([type])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  content    String
  /// Bản chữ thuần (giữ để tương thích) và bản có cấu trúc RichDoc của phương án.
  contentDoc Json?
  isCorrect  Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]

  @@unique([questionId, label])
  @@index([questionId])
}

model Exam {
  id                String     @id @default(cuid())
  title             String
  slug              String     @unique
  description       String?
  subjectId         String
  durationMinutes   Int
  status            ExamStatus @default(DRAFT)
  year              Int?
  isFeatured        Boolean    @default(false)
  /// Phạm vi đề: công khai (chỉ ADMIN quản lý) hoặc thuộc một lớp học.
  scope             ExamScope  @default(PUBLIC)
  classroomId       String?
  createdById       String?
  gradeLevel        Int?
  /// Hướng dẫn làm bài: bản chữ thuần (dự phòng) và bản có cấu trúc RichDoc.
  instructions      String?
  instructionsDoc   Json?
  /// Bộ đếm phiên bản nội dung — dùng phát hiện xung đột khi nhiều tab cùng sửa.
  revision          Int        @default(1)
  /// Phiên bản nội dung đã xuất bản gần nhất (NULL khi đề còn là nháp).
  publishedRevision Int?
  publishedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classroom   Classroom?       @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("ExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  questions   ExamQuestion[]
  attempts    Attempt[]
  assignments ExamAssignment[]
  assets      MediaAsset[]

  @@index([subjectId])
  @@index([status])
  @@index([isFeatured])
  @@index([status, isFeatured])
  @@index([scope, status])
  @@index([classroomId])
  @@index([createdById])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  questionId String
  position   Int
  points     Float    @default(1)
  createdAt  DateTime @default(now())

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examId, questionId])
  @@unique([examId, position])
  @@index([examId])
  @@index([questionId])
}

model Attempt {
  id        String  @id @default(cuid())
  // Định danh phiên: là id phiên đăng nhập (Better Auth) của chủ lượt làm bài, hoặc
  // cookie ẩn danh `luyenthi_session` của các lượt làm bài cũ trước khi có tài khoản.
  sessionId String
  // Chủ lượt làm bài. Lượt làm bài ẩn danh cũ (trước khi có tài khoản) giữ giá trị NULL.
  userId    String?
  examId    String

  status               AttemptStatus @default(IN_PROGRESS)
  startedAt            DateTime      @default(now())
  expiresAt            DateTime
  submittedAt          DateTime?
  score                Float?
  maxScore             Float?
  correctCount         Int?
  incorrectCount       Int?
  unansweredCount      Int?
  // Phục vụ khôi phục "câu đang xem" sau khi reload.
  lastQuestionPosition Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers AttemptAnswer[]

  @@index([sessionId])
  @@index([examId])
  @@index([sessionId, examId, status])
  @@index([status, expiresAt])
  // Lịch sử làm bài của một người dùng (sắp xếp mới nhất trước).
  @@index([userId, startedAt])
  @@index([userId, examId, status])
}

model AttemptAnswer {
  id               String  @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?

  // Snapshot được ghi tại thời điểm bắt đầu bài để việc sửa câu hỏi sau này
  // không làm thay đổi lượt làm bài đã tạo.
  snapshotPosition         Int
  snapshotType             QuestionType
  snapshotLevel            QuestionLevel
  snapshotPoints           Float
  snapshotContent          String
  /// Bản có cấu trúc (RichDoc) của nội dung câu hỏi tại thời điểm bắt đầu bài.
  snapshotContentDoc       Json?
  snapshotExplanation      String?
  /// Bản có cấu trúc (RichDoc) của lời giải tại thời điểm bắt đầu bài.
  snapshotExplanationDoc   Json?
  snapshotOptions          Json
  snapshotCorrectOptionIds Json
  snapshotRule             Json?

  isCorrect  Boolean?
  isFlagged  Boolean   @default(false)
  answeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempt        Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
}

// ---------------------------------------------------------------------------
// Xác thực người dùng (Better Auth 1.7 + Prisma adapter).
// Cột/thuộc tính của 5 model dưới đây phải khớp đúng bảng mà Better Auth mong đợi
// (`getExpectedSchema`); adapter còn tự kiểm tra schema lúc chạy và sẽ báo lỗi rõ
// ràng nếu thiếu bảng/cột. Vì vậy mọi cột Better Auth có thể không ghi đều phải
// nullable hoặc có giá trị mặc định.
// ---------------------------------------------------------------------------

model User {
  // Better Auth tự sinh id (chuỗi 32 ký tự) nên cột này không dùng @default.
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // Vai trò & trạng thái khoá tài khoản. `input: false` phía Better Auth nghĩa là
  // client KHÔNG thể tự gửi các trường này lên khi đăng ký/đăng nhập.
  role      UserRole  @default(STUDENT)
  banned    Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions              Session[]
  accounts              Account[]
  attempts              Attempt[]
  teacherApplications   TeacherApplication[] @relation("TeacherApplicationOwner")
  reviewedApplications  TeacherApplication[] @relation("TeacherApplicationReviewer")
  classroomsOwned       Classroom[]          @relation("ClassroomOwner")
  classroomMemberships  ClassroomMember[]    @relation("ClassroomMemberUser")
  classroomMembersAdded ClassroomMember[]    @relation("ClassroomMemberAdder")
  examsCreated          Exam[]               @relation("ExamCreator")
  examAssignments       ExamAssignment[]     @relation("AssignmentCreator")
  mediaAssets           MediaAsset[]

  @@index([role])
  @@index([banned])
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Băm mật khẩu scrypt do Better Auth sinh ra (không bao giờ trả về qua API).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/**
 * Bộ đếm giới hạn tần suất (chống dò mật khẩu). `lastRequest` là mốc thời gian
 * `Date.now()` (mili giây) nên dùng Float: Better Auth truyền vào một số JS và
 * cột BigInt của Prisma chỉ nhận BigInt, còn Float lưu chính xác giá trị này.
 */
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest Float
}

/**
 * Đơn xin quyền giáo viên. `pendingKey` = userId khi đơn đang PENDING và NULL khi
 * đã xử lý; nhờ vậy ràng buộc UNIQUE của database chặn tuyệt đối việc nộp trùng
 * nhiều đơn đang chờ, trong khi một người vẫn có thể nộp lại sau khi bị từ chối.
 */
model TeacherApplication {
  id              String                   @id @default(cuid())
  userId          String
  status          TeacherApplicationStatus @default(PENDING)
  pendingKey      String?                  @unique
  school          String?
  subjectId       String?
  experienceYears Int?
  contactPhone    String?
  motivation      String
  reviewNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user       User     @relation("TeacherApplicationOwner", fields: [userId], references: [id], onDelete: Cascade)
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("TeacherApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Lớp học, giao đề và media của đề thi (tính năng tạo & quản lý đề thi).
// ---------------------------------------------------------------------------

/**
 * Lớp học do một giáo viên phụ trách. Đề thi phạm vi CLASS luôn thuộc đúng một lớp;
 * quyền quản lý đề suy ra từ lớp này chứ không nhận từ client.
 */
model Classroom {
  id          String   @id @default(cuid())
  name        String
  description String?
  subjectId   String?
  gradeLevel  Int?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation("ClassroomOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  members     ClassroomMember[]
  exams       Exam[]
  assignments ExamAssignment[]
  assets      MediaAsset[]

  /// Một giáo viên không thể có hai lớp trùng tên (chặn tạo trùng do bấm nhiều lần).
  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([subjectId])
}

/**
 * Thành viên lớp: giáo viên phụ trách cùng lớp và học sinh được thêm vào lớp.
 */
model ClassroomMember {
  id          String              @id @default(cuid())
  classroomId String
  userId      String
  role        ClassroomMemberRole @default(STUDENT)
  addedById   String?
  createdAt   DateTime            @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation("ClassroomMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation("ClassroomMemberAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([classroomId, userId])
  @@index([classroomId, role])
  @@index([userId])
}

/**
 * Một lần giao đề cho một lớp. Tách khỏi nội dung đề: xuất bản nội dung và giao đề là
 * hai thao tác riêng, nên lịch mở/đóng, thời lượng và số lượt làm nằm ở đây.
 */
model ExamAssignment {
  id              String    @id @default(cuid())
  examId          String
  classroomId     String
  createdById     String
  title           String?
  opensAt         DateTime?
  closesAt        DateTime?
  /// Ghi đè thời lượng làm bài của đề (phút); NULL nghĩa là dùng thời lượng của đề.
  durationMinutes Int?
  /// Số lượt làm tối đa cho mỗi học sinh; NULL nghĩa là không giới hạn.
  allowedAttempts Int?
  /// Mốc được phép xem đáp án/lời giải; NULL nghĩa là chỉ xem sau khi nộp bài.
  revealAnswersAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy User      @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Mỗi đề chỉ giao một lần cho một lớp.
  @@unique([examId, classroomId])
  @@index([classroomId])
  @@index([examId])
}

/**
 * Ảnh/đồ thị tải lên cho nội dung đề. Tệp nằm trên đĩa (`MEDIA_STORAGE_DIR`), database
 * chỉ giữ metadata; nội dung đề tham chiếu tới đây bằng `assetId` nên không nhúng base64.
 */
model MediaAsset {
  id          String         @id @default(cuid())
  uploaderId  String
  kind        MediaAssetKind @default(IMAGE)
  mimeType    String
  byteSize    Int
  width       Int?
  height      Int?
  alt         String?
  /// Tên tệp ngẫu nhiên trên đĩa (không dùng tên gốc do người dùng gửi lên).
  storageKey  String         @unique
  examId      String?
  classroomId String?
  createdAt   DateTime       @default(now())

  uploader  User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  exam      Exam?      @relation(fields: [examId], references: [id], onDelete: SetNull)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([uploaderId])
  @@index([examId])
  @@index([classroomId])
}
