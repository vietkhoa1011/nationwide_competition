# Sao chép tệp này thành `.env` rồi chỉnh lại thông tin kết nối PostgreSQL.
# KHÔNG commit tệp .env thật (đã được liệt kê trong .gitignore).

# Cổng trên máy host cho container PostgreSQL trong docker-compose.yml.
# Mặc định 5433 vì cổng 5432 thường đã bị PostgreSQL cài trực tiếp trên máy chiếm.
POSTGRES_PORT=5433

# Chuỗi kết nối PostgreSQL dùng cho Prisma CLI (migrate/seed) và Prisma Client.
# Cổng phải khớp POSTGRES_PORT ở trên (host 5433 -> container 5432).
DATABASE_URL="postgresql://luyenthi:luyenthi@localhost:5433/luyenthi2027?schema=public"

# Khoá bí mật để ký cookie phiên của Better Auth. BẮT BUỘC và phải dài tối thiểu 32 ký tự.
# Sinh khoá mới bằng lệnh sau rồi dán vào đây (mỗi môi trường dùng một khoá riêng):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="thay-bang-khoa-ngau-nhien-dai-toi-thieu-32-ky-tu"

# Địa chỉ công khai của ứng dụng: dùng làm baseURL của Better Auth và origin mặc định
# được tin cậy (chống CSRF cho các endpoint xác thực).
BETTER_AUTH_URL="http://localhost:3000"

# (Tuỳ chọn) Danh sách origin bổ sung được phép gọi API xác thực, phân tách bằng dấu phẩy.
# Ví dụ khi chạy bản kiểm thử end-to-end trên cổng 3123:
#   AUTH_TRUSTED_ORIGINS="http://localhost:3123"
# AUTH_TRUSTED_ORIGINS=""

# (Tuỳ chọn) Tài khoản quản trị viên đầu tiên cho `npm run db:admin`.
# Có thể bỏ qua và truyền tham số dòng lệnh thay thế:
#   npm run db:admin -- admin@luyenthi.vn MatKhau123 "Quản trị viên"
# ADMIN_EMAIL="admin@luyenthi.vn"
# ADMIN_PASSWORD="MatKhau123"
# ADMIN_NAME="Quản trị viên"

