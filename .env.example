# Sao chép tệp này thành `.env` rồi chỉnh lại thông tin kết nối PostgreSQL.
# KHÔNG commit tệp .env thật (đã được liệt kê trong .gitignore).

# Cổng trên máy host cho container PostgreSQL trong docker-compose.yml.
# Mặc định 5433 vì cổng 5432 thường đã bị PostgreSQL cài trực tiếp trên máy chiếm.
POSTGRES_PORT=5433

# Chuỗi kết nối PostgreSQL dùng cho Prisma CLI (migrate/seed) và Prisma Client.
# Cổng phải khớp POSTGRES_PORT ở trên (host 5433 -> container 5432).
DATABASE_URL="postgresql://luyenthi:luyenthi@localhost:5433/luyenthi2027?schema=public"
