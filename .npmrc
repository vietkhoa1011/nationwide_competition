# better-auth khai báo nhiều peerDependenciesMeta.optional (@sveltejs/kit, drizzle-orm, ...).
# npm 11 vẫn cố cài optional peer và xung đột vite (vitest 3 cần vite 7, @sveltejs/vite-plugin-svelte cần vite 8),
# nên chốt legacy-peer-deps cho cả dự án để `npm install` / `npm ci` chạy tất định.
legacy-peer-deps=true
